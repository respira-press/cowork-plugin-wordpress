{
  "mcpServers": {
    "respira-wordpress": {
      "command": "npx",
      "args": [
        "-y",
        "@respira/wordpress-mcp-server@8.3.18"
      ],
      "env": {
        "RESPIRA_CONFIG_FILE": "${HOME}/.respira/config.json",
        "RESPIRA_AGENT_CLIENT": "cowork",
        "RESPIRA_AGENT_TRANSPORT": "cowork-mcp",
        "RESPIRA_BOOTSTRAP_OK": "1"
      }
    }
  }
}
